# ───────────────────────────────────────────────────────────
# SWIFT TRADE — Hong Kong, International
# ───────────────────────────────────────────────────────────

# SUPABASE (Required) ── https://supabase.com/dashboard/project/YOUR/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# APP
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Swift Trade

# ADMIN ── email that gets pinged for SwiftBridge requests
ADMIN_NOTIFICATION_EMAIL=ops@swifttrade.io

# AUTH
JWT_SECRET=change-me-to-a-32-character-random-string

# EMAIL (optional) ── https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# STOCKS LIVE PRICES (optional) ── https://finnhub.io
FINNHUB_API_KEY=
